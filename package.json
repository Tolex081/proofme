{
  "name": "proofme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "test:unit": "vitest run tests/unit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "playwright test",
    "capture:screens": "playwright test --config playwright.capture.config.ts",
    "admin:grant": "node scripts/grant-admin.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@hot-labs/near-connect": "0.12.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
