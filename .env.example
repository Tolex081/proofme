# ProofMe environment variables. Names and safe placeholders only.
# Copy to .env.local for local development. Never commit real values.

# App
APP_ENV=local                      # local | preview | production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# Leave DATABASE_URL empty locally to use the embedded PostgreSQL (PGlite),
# stored in PGLITE_DATA_DIR. Required in preview and production.
DATABASE_URL=
PGLITE_DATA_DIR=.pglite            # a folder in the project root, or memory:// to keep nothing

# Authentication (Better Auth)
# At least 32 random characters, different in every environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# NEAR
NEAR_NETWORK=testnet               # sandbox | testnet (mainnet is not enabled in this build)
# NEAR_RPC_URL=                    # Milestone 6
# NEAR_CONTRACT_ID=                # Milestone 6
# NEAR_EXPLORER_BASE_URL=          # Milestone 6
