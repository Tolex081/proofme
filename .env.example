# ProofMe environment variables. Names and safe placeholders only.
# Copy to .env.local for local development. Never commit real values.
# Variables are listed in the milestone that introduces them.

# App (Milestone 0)
APP_ENV=local                      # local | preview | production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NEAR (Milestone 0: network label; Milestone 6: the rest)
NEAR_NETWORK=testnet               # sandbox | testnet (mainnet is not enabled in this build)
# NEAR_RPC_URL=
# NEAR_CONTRACT_ID=
# NEAR_EXPLORER_BASE_URL=

# Database (Milestone 2)
# DATABASE_URL=

# Authentication (Milestone 2)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
