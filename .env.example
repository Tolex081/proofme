# ProofMe environment variables. Names and safe placeholders only.
# Copy to .env.local for local development. Never commit real values.

# App
APP_ENV=local                      # local | preview | production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# Leave DATABASE_URL empty locally to use the embedded PostgreSQL (PGlite),
# stored in PGLITE_DATA_DIR. Required in preview and production.
DATABASE_URL=
PGLITE_DATA_DIR=.pglite            # a folder in the project root, or memory:// to keep nothing

# Authentication (Better Auth)
# At least 32 random characters, different in every environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# NEAR
NEAR_NETWORK=testnet               # sandbox | testnet (mainnet is not enabled in this build)
NEAR_RPC_URL=https://test.rpc.fastnear.com
# The deployed proofme-attestations contract. Leave empty until it is deployed:
# approved records then stay "awaiting NEAR anchor" and nothing can be minted.
NEAR_CONTRACT_ID=
NEAR_EXPLORER_BASE_URL=https://testnet.nearblocks.io

# Public credential documents (IPFS through Pinata)
# A Pinata JWT with permission to upload files. Without it, a credential's NEP-177 reference
# points at this site's own copy (/api/credentials/<id>), which is checkable but not durable.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# GitHub identity linking (Evidence Agent)
# A GitHub OAuth app. Callback URL: <NEXT_PUBLIC_APP_URL>/api/github/callback. No scopes are
# requested: ProofMe reads only the public profile and public repositories.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional token used only to raise the rate limit for public GitHub API reads.
GITHUB_API_TOKEN=

# Evidence Agent analysis (NEAR AI Cloud, OpenAI-compatible)
# Without a key the agent still runs every source check and says the analysis did not run.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8

# Platform administrators (local development only)
# Accounts that sign up with these emails (comma-separated) become administrators. Ignored
# unless APP_ENV=local. Elsewhere, use: npm run admin:grant -- someone@example.org
# PROOFME_LOCAL_ADMIN_EMAIL=
