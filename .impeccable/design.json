  "narrative": {
    "northStar": "People first",
    "overview": "Atesta leads with people and the work they did, shown as real product cards. Warm, friendly and modern, in light and dark themes.",
    "keyCharacteristics": [
      "Show the product: every major section contains a working or realistic piece of the product.",
